
import os
import streamlit as st
import pandas as pd

try:
    import google.generativeai as genai
except ImportError:
    genai = None

API_KEY = os.getenv("GEMINI_API_KEY")
if genai is not None and API_KEY:
    genai.configure(api_key=API_KEY)

st.title("AI DIGITAL WELLBEING DASHBOARD")
st.write("Analyze your digital wellbeing data with CSV upload or manual entry.")

if genai is None or not API_KEY:
    st.warning("Gemini answers are disabled until google-genai is installed and an API key is set.")

uploaded_file = st.file_uploader(
    "Upload CSV with Date, App_Name, Category, Minutes_Used",
    type=["csv"],
)

if uploaded_file:
    try:
        df = pd.read_csv(uploaded_file)
        df["Minutes_Used"] = pd.to_numeric(df["Minutes_Used"], errors="coerce").fillna(0)
    except Exception as error:
        st.error(f"CSV error: {error}")
        df = None
else:
    df = pd.read_csv("screentime.csv")
    df["Minutes_Used"] = pd.to_numeric(df["Minutes_Used"], errors="coerce").fillna(0)

categories = [
    "Social Media",
    "Education",
    "Coding",
    "Entertainment",
    "Productivity",
    "Communication",
    "Music",
    "Shopping",
    "Finance",
]

selected_day = st.sidebar.selectbox(
    "Select Date",
    sorted(df["Date"].unique())
)

goal = st.sidebar.slider(
    "Daily Goal",
    60,
    600,
    240
)

if "rows" not in st.session_state:
    st.session_state.rows = 1

if st.button("Add Another App"):
    st.session_state.rows += 1

today_df = df[df["Date"] == selected_day]

total = today_df["Minutes_Used"].sum()
delta_vs_goal = total - goal

col1, col2, col3 = st.columns(3)
col1.metric("Total Minutes Today", int(total))
col2.metric(
    "Most Used App",
    today_df.loc[today_df["Minutes_Used"].idxmax(), "App_Name"] if not today_df.empty else "N/A"
)
col3.metric("Vs Daily Goal", int(delta_vs_goal), delta=int(delta_vs_goal), delta_color="inverse")

daily = df.groupby("Date")["Minutes_Used"].sum()

st.line_chart(daily)

summary = (
    today_df
    .groupby("Category")["Minutes_Used"]
    .sum()
    .to_string()
)

with st.form("screen_time"):
    app_names = []
    app_categories = []
    app_minutes = []

    for i in range(st.session_state.rows):
        st.subheader(f"App {i+1}")
        app_names.append(st.text_input("App Name", key=f"app_{i}"))
        app_categories.append(st.selectbox("Category", categories, key=f"category_{i}"))
        app_minutes.append(st.number_input("Minutes Used", min_value=0, step=15, key=f"minutes_{i}"))

    user_question = st.text_area(
        "Ask Gemini a question about this data",
        help="Optional. Leave blank for a general Gemini summary.",
    )

    if st.form_submit_button("ANALYZE"):
        if df is not None:
            df = df.copy()
        else:
            df = pd.DataFrame(
                {
                    "App_Name": app_names,
                    "Category": app_categories,
                    "Minutes_Used": app_minutes,
                }
            )
            df = df[df["App_Name"].str.strip() != ""]

        if df.empty:
            st.warning("No data to analyze.")
        else:
            st.dataframe(df)
            total = int(df["Minutes_Used"].sum())
            average = round(df["Minutes_Used"].mean(), 1)
            maximum = int(df["Minutes_Used"].max())

            col1, col2, col3 = st.columns(3)
            col1.metric("Total Minutes", total)
            col2.metric("Average Minutes", average)
            col3.metric("Max Minutes", maximum)

            col1, col2, col3 = st.columns(3)
            col1.metric(
                "Most Used App",
                df.loc[df["Minutes_Used"].idxmax(), "App_Name"]
            )
            col2.metric(
                "Top Category",
                df.groupby("Category")["Minutes_Used"].sum().idxmax(),
            )
            col3.metric("Least Used App", df.loc[df["Minutes_Used"].idxmin(), "App_Name"])

            st.subheader("Minutes Used by App")
            st.bar_chart(df.set_index("App_Name")["Minutes_Used"])

            if genai is not None and API_KEY:
                prompt = f"""
You are Life-OS.

Today's screen time:

{summary}

Be brutally honest but supportive.

Don't simply tell the user to reduce screen time.

Instead:

• Explain the biggest problems.

• Mention positive habits.

• Recommend physical activities.

• Suggest books.

• Suggest fitness.

• Suggest sleep improvements.

• Suggest time blocks.

Finally give:

Productivity Score /10

Health Score /10

One challenge for tomorrow.
"""
                if user_question:
                    prompt += f"User question: {user_question}\n\n"
                prompt += (
                    "Describe patterns, trends, and recommendations for better digital wellbeing."
                )

                with st.spinner("Generating Gemini insights..."):
                    model = genai.GenerativeModel("gemini-1.5-flash")
                    response = model.generate_content(prompt)
                answer = response.text

                st.subheader("Gemini Insights")
                if total > goal:
                    st.warning(f"You're {total - goal} minutes over your goal today.")
                else:
                    st.info(f"You're {goal - total} minutes under your goal today.")
                st.markdown(answer)
            else:
                st.info("Gemini insights are unavailable.")

# Phase 4 innovation deliverable: Shareable Accountability Link
st.query_params["date"] = selected_day
st.query_params["total"] = str(int(total))
st.query_params["goal"] = str(goal)
st.caption("Copy this page's URL to share today's screen time totals with an accountability partner.")
